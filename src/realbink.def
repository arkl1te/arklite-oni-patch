; Forward every Bink export Daodan looks up in realbink.dll to the original Bink DLL.
LIBRARY realbink
EXPORTS
  _BinkBufferBlit@12=bink_orig._BinkBufferBlit@12
  _BinkBufferClose@4=bink_orig._BinkBufferClose@4
  _BinkBufferLock@4=bink_orig._BinkBufferLock@4
  _BinkBufferOpen@16=bink_orig._BinkBufferOpen@16
  _BinkBufferSetOffset@12=bink_orig._BinkBufferSetOffset@12
  _BinkBufferUnlock@4=bink_orig._BinkBufferUnlock@4
  _BinkClose@4=bink_orig._BinkClose@4
  _BinkCopyToBuffer@28=bink_orig._BinkCopyToBuffer@28
  _BinkDoFrame@4=bink_orig._BinkDoFrame@4
  _BinkGetRects@8=bink_orig._BinkGetRects@8
  _BinkNextFrame@4=bink_orig._BinkNextFrame@4
  _BinkOpen@8=bink_orig._BinkOpen@8
  _BinkOpenDirectSound@4=bink_orig._BinkOpenDirectSound@4
  _BinkService@4=bink_orig._BinkService@4
  _BinkSetIOSize@4=bink_orig._BinkSetIOSize@4
  _BinkSetSoundOnOff@8=bink_orig._BinkSetSoundOnOff@8
  _BinkSetSoundSystem@8=bink_orig._BinkSetSoundSystem@8
  _BinkSetVolume@8=bink_orig._BinkSetVolume@8
  _BinkWait@4=bink_orig._BinkWait@4
